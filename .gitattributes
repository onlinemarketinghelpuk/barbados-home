# The build matches on LF (tools/build-options.mjs), and the pages are served as
# static files, so every text file is LF in the repo and in the working tree too
# — Git for Windows checks out CRLF by default, which breaks the build.
* text=auto eol=lf

# Images, video and PDFs: never converted, never diffed as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.pdf  binary
